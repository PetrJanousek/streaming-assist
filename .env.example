# Copy to .env and fill secrets. Empty ANTHROPIC_API_KEY degrades to rules+template.

# LLM
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-haiku-4-5
LLM_TIMEOUT_MS=2500

# Catalog / retrieval
HOME_COUNTRY=United States
DATASET_URL=https://huggingface.co/datasets/hugginglearners/netflix-shows/resolve/main/netflix_titles.csv
DATASET_SHA256=b5e2528aaac6a9a1544f68fb1ad004f46fabbf8bc2644d96f7364ca8b66ce959
DATASET_FETCH_TIMEOUT_S=60
EMBED_MODEL=BAAI/bge-small-en-v1.5
RRF_K=60
ROUTER_THETA1=0.55
ROUTER_THETA_GAP=0.08
RANK_W_POP=0.50
RANK_W_CONSTRAINT=0.30
RANK_W_SEMANTIC=0.20

# Session / limits
SESSION_TTL_S=86400
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=20
HARD_TIMEOUT_MS=8000
RETRIEVE_MAX_ATTEMPTS=2
GUARD_MAX_CHARS=500
REPLY_MAX_CHARS=600

# Observability
LANGSMITH_TRACING=0
LOG_LEVEL=INFO
DEBUG_META=0

# Stores (host ports; compose overrides these inside the network)
POSTGRES_DSN=postgresql+asyncpg://assist:assist@localhost:5432/assist
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
REDIS_URL=redis://localhost:6379/0
ELASTICSEARCH_URL=http://localhost:9200
EMBEDDER_URL=http://localhost:8080
EMBEDDER_TIMEOUT_MS=5000
EMBEDDER_RETRIES=2
CATALOG_TIMEOUT_MS=500
